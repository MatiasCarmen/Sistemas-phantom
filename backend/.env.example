PORT=3000
# Interfaz de escucha. Use 127.0.0.1 si el backend solo debe ser accesible desde este equipo.
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=phantom_erp
# Orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:5173
# OBLIGATORIO (mín. 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DISABLE_HMR=false
# Saltos de proxy inverso de confianza (ej. 1 detrás de Nginx). Vacío = conexión directa.
TRUST_PROXY=
